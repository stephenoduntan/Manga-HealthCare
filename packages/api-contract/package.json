{
  "name": "@manga/api-contract",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./triage": {
      "types": "./dist/triage.contract.d.ts",
      "import": "./dist/triage.contract.mjs",
      "require": "./dist/triage.contract.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/triage.contract.ts --format esm,cjs --dts",
    "lint": "tsc --noEmit",
    "test": "jest",
    "dev": "tsup src/index.ts src/triage.contract.ts --format esm,cjs --watch --dts"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
