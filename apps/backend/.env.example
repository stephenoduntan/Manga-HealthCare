# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/manga_healthcare?schema=public"

# Redis (Upstash or local)
REDIS_URL="redis://localhost:6379"

# JWT & Auth Secrets
JWT_SECRET="super-secret-manga-jwt-key"
JWT_REFRESH_SECRET="super-secret-manga-refresh-key"

# Server & Subdomain CORS
PORT=4000
CORS_ORIGINS="https://mangahealthcare.com,https://app.mangahealthcare.com,https://doctor.mangahealthcare.com,https://partner.mangahealthcare.com,https://admin.mangahealthcare.com,http://localhost:3000,http://localhost:3001"

# Payments (Paystack & Flutterwave)
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."
PAYSTACK_WEBHOOK_SECRET=""
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-..."
FLUTTERWAVE_SECRET_HASH="manga-flw-webhook-hash"

# Video / Audio Provider (Daily.co / Agora)
DAILY_API_KEY=""
DAILY_DOMAIN="manga-healthcare"
DAILY_WEBHOOK_SECRET=""

# Messaging & Notifications (Termii SMS, Resend Email, Firebase FCM)
TERMII_API_KEY=""
TERMII_SENDER_ID="MangaHealth"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Manga Healthcare <no-reply@mangahealthcare.com>"
FIREBASE_PROJECT_ID=""
FIREBASE_ACCESS_TOKEN=""

# Encrypted Object Storage (AWS S3 eu-west-1 / af-south-1)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-1"
AWS_S3_BUCKET="manga-healthcare-documents"

# Observability (Sentry & Better Stack Logtail)
SENTRY_DSN=""
BETTERSTACK_SOURCE_TOKEN=""
